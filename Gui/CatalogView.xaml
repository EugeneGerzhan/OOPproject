<UserControl x:Class="OOPproject.Gui.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- One card of the list: a composite of a portrait, a name with stars, a title, a line of facts and a short text -->
        <DataTemplate x:Key="CardTemplate">
            <Border Margin="2" Padding="8" CornerRadius="6" Background="#FAFAFA"
                    BorderBrush="{Binding AccentBrush}" BorderThickness="4,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="96" Height="96" VerticalAlignment="Top">
                        <!-- the placeholder is visible until the portrait is loaded (or when there is none) -->
                        <Border CornerRadius="8" Background="{Binding AccentBrush}">
                            <TextBlock Text="{Binding Initial}" FontSize="40" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="8">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill"
                                            AlignmentY="Top" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Stars}" Foreground="#E0A100" FontSize="14" />
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Title}" Foreground="Gray" FontStyle="Italic" />
                        <TextBlock Text="{Binding Info}" Margin="0,4,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ShortDescription}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   MaxHeight="54" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TalentTemplate">
            <StackPanel Margin="0,0,0,8">
                <TextBlock>
                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="{Binding Kind, Mode=OneWay}" Foreground="Gray" />
                </TextBlock>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- search, filters, sorting -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox x:Name="SearchBox" Width="170" Margin="0,0,12,0" TextChanged="Filter_Changed" />
            <TextBlock Text="Vision:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="VisionBox" Width="100" Margin="0,0,12,0" SelectionChanged="Filter_Changed" />
            <TextBlock Text="Weapon:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="WeaponBox" Width="100" Margin="0,0,12,0" SelectionChanged="Filter_Changed" />
            <TextBlock Text="Rarity:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="RarityBox" Width="70" Margin="0,0,12,0" SelectedIndex="0"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Any" />
                <ComboBoxItem Content="4+" />
                <ComboBoxItem Content="5" />
            </ComboBox>
            <TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="SortBox" Width="80" Margin="0,0,12,0" SelectedIndex="0"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Name" />
                <ComboBoxItem Content="Rarity" />
                <ComboBoxItem Content="Vision" />
            </ComboBox>
            <Button x:Name="RefreshButton" Content="Update from server" Padding="10,2" Click="Refresh_Click" />
        </WrapPanel>

        <!-- the scrollable list of cards and the details of the chosen one -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="CardsList" Grid.Column="0" ItemTemplate="{StaticResource CardTemplate}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionChanged="CardsList_SelectionChanged" />

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <TextBlock x:Name="EmptyText" Grid.Column="2" Text="Select a character to see the details."
                       Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <ScrollViewer x:Name="DetailsPanel" Grid.Column="2" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,0,12,12">
                    <Grid Width="220" Height="220" HorizontalAlignment="Left">
                        <Border CornerRadius="10" Background="{Binding AccentBrush}">
                            <TextBlock Text="{Binding Initial}" FontSize="90" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="10">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill" AlignmentY="Top" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding PortraitInfo}" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                               Margin="0,4,0,8" />

                    <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Title}" Foreground="Gray" FontStyle="Italic" />
                    <TextBlock Text="{Binding Stars}" Foreground="#E0A100" FontSize="16" />
                    <TextBlock Text="{Binding Info}" FontWeight="SemiBold" Margin="0,2,0,8" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Button Content="Add to the game" HorizontalAlignment="Left" Padding="12,3" Margin="0,0,0,12"
                            ToolTip="Imports the character into the game (command: remote import char)"
                            Click="AddToGame_Click" />

                    <TextBlock Text="Talents" FontWeight="Bold" FontSize="15" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Talents}" ItemTemplate="{StaticResource TalentTemplate}" />
                    <TextBlock Text="Passive talents" FontWeight="Bold" FontSize="15" Margin="0,6,0,4" />
                    <ItemsControl ItemsSource="{Binding Passives}" ItemTemplate="{StaticResource TalentTemplate}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- status -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="120" Height="12"
                         IsIndeterminate="True" Visibility="Collapsed" Margin="8,0,0,0" />
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="Gray" Margin="8,0,0,0" />
            <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>