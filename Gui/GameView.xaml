<UserControl x:Class="OOPproject.Gui.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- saves: choose and load -->
        <GroupBox Grid.Column="0" Header="Saves" Margin="0,0,8,0">
            <DockPanel Margin="6">
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="LoadButton" Content="Load" Padding="12,3" Margin="0,0,6,6"
                            IsEnabled="False" Click="Load_Click" />
                    <Button x:Name="ContinueButton" Content="Continue" Padding="12,3" Margin="0,0,6,6"
                            ToolTip="Continue from the last save (also the autosave)" Click="Continue_Click" />
                    <Button x:Name="SaveButton" Content="Save as..." Padding="12,3" Margin="0,0,6,6"
                            Click="SaveAs_Click" />
                    <Button x:Name="RefreshSavesButton" Content="Refresh" Padding="12,3" Margin="0,0,6,6"
                            Click="RefreshSaves_Click" />
                </WrapPanel>
                <ListBox x:Name="SavesList" SelectionChanged="SavesList_SelectionChanged"
                         MouseDoubleClick="SavesList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                           Foreground="Gray" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <!-- the window as a console -->
        <DockPanel Grid.Column="1">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button Content="roster" Tag="game roster" Padding="10,2" Margin="0,0,6,0" Click="QuickCommand_Click" />
                <Button Content="status" Tag="game status" Padding="10,2" Margin="0,0,6,0" Click="QuickCommand_Click" />
                <Button Content="history" Tag="game history" Padding="10,2" Margin="0,0,6,0" Click="QuickCommand_Click" />
                <Button Content="results" Tag="game results" Padding="10,2" Margin="0,0,6,0" Click="QuickCommand_Click" />
                <Button Content="storage" Tag="storage" Padding="10,2" Margin="0,0,6,0" Click="QuickCommand_Click" />
                <Button Content="help" Tag="help" Padding="10,2" Margin="0,0,6,0" Click="QuickCommand_Click" />
                <Button Content="Clear" Padding="10,2" Margin="12,0,0,0" Click="Clear_Click" />
            </WrapPanel>

            <TextBlock x:Name="DataFolderText" DockPanel.Dock="Bottom" Foreground="Gray" FontSize="11"
                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />

            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Padding="14,3"
                        Margin="6,0,0,0" Click="Send_Click" />
                <TextBlock DockPanel.Dock="Left" Text="&gt;" FontFamily="Consolas" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="InputBox" FontFamily="Consolas" FontSize="14" Padding="4,3"
                         KeyDown="InputBox_KeyDown" />
            </DockPanel>

            <TextBox x:Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                     Background="#1E1E1E" Foreground="#D4D4D4" Padding="8" />
        </DockPanel>
    </Grid>
</UserControl>